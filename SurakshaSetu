              "content": "/* SurakshaSetu — application shell and hash router */\n'use strict';\n\n(function () {\n  const SS = window.SS;\n  const state = SS.state;\n\n  function currentPageName() {\n    const raw = (location.hash || '').replace(/^#\\/?/, '').split('?')[0].trim();\n    if (!raw) return state.user ? 'home' : 'auth';\n    return raw.toLowerCase();\n  }\n\n  function shell(page) {\n    const user = state.user || {};\n    const points = state.progress ? state.progress.points : 0;\n    const nav = SS.nav.map((section) => {\n      const items = section.items.filter((item) => !item.admin || (user.role === 'admin'));\n      if (!items.length) return '';\n      return '<div class=\"nav-label\">' + SS.esc(section.group) + '</div>' + items.map((item) =>\n        '<button class=\"nav-link\" data-nav=\"' + item.id + '\">' +\n        SS.icon(item.icon) + '<span>' + SS.esc(item.label) + '</span>' +\n        (item.id === 'offline' && state.queue.length ? '<span class=\"nav-badge\">' + state.queue.length + '</span>' : '') +\n        '</button>'\n      ).join('');\n    }).join('');\n\n    const initials = String(user.name || 'S').split(/\\s+/).slice(0, 2).map((part) => part[0]).join('').toUpperCase();\n\n    return '<div class=\"layout\">' +\n      '<aside class=\"sidebar\">' +\n        '<div class=\"brand\"><div class=\"brand-mark\">SS</div>' +\n          '<div class=\"brand-name\">SurakshaSetu<small>SAFETY · ID · OPPORTUNITY</small></div></div>' +\n        '<nav class=\"nav-scroll\">' + nav + '</nav>' +\n        '<div class=\"sidebar-foot\">Logged in as <b>' + SS.esc(user.name || 'Worker') + '</b><br>' +\n          SS.esc(user.wid || '') + ' · ' + points + ' points</div>' +\n      '</aside>' +\n      '<main class=\"main\">' +\n        '<header class=\"topbar\">' +\n          '<button class=\"icon-btn menu-btn\" data-action=\"menu\" aria-label=\"Open menu\">' + SS.icon('menu') + '</button>' +\n          '<div class=\"topbar-title\">' + SS.esc(page.title || 'SurakshaSetu') +\n            '<small>' + SS.esc(page.sub || '') + '</small></div>' +\n          '<div class=\"topbar-actions\">' +\n            '<button class=\"icon-btn\" data-action=\"lang\" title=\"Language\">' + SS.icon('globe') + ' ' + (state.prefs.lang === 'hi' ? 'HI' : 'EN') + '</button>' +\n            '<button class=\"icon-btn\" data-action=\"theme\" title=\"Toggle dark mode\">' + SS.icon(state.prefs.theme === 'dark' ? 'sun' : 'moon') + '</button>' +\n            '<span class=\"badge amber\" title=\"Your points\">' + SS.icon('star', 12) + ' ' + points + '</span>' +\n            '<div class=\"user-chip\"><div class=\"avatar\">' +\n              (user.photo ? '<img src=\"' + SS.esc(user.photo) + '\" alt=\"\">' : SS.esc(initials)) +\n              '</div><div class=\"who\">' + SS.esc(user.name || 'Worker') + '<small>' + SS.esc(user.wid || '') + '</small></div></div>' +\n            '<button class=\"icon-btn\" data-action=\"logout\" title=\"Sign out\">' + SS.icon('logout') + '</button>' +\n          '</div>' +\n        '</header>' +\n        '<div class=\"view\" id=\"view\"></div>' +\n      '</main>' +\n    '</div>';\n  }\n\n  function bindShell() {\n    SS.bindAll(document, '[data-nav]', 'click', (event) => {\n      const id = event.currentTarget.getAttribute('data-nav');\n      document.body.classList.remove('nav-open');\n      SS.go(id);\n    });\n    SS.bindOnce(document, '[data-action=\"menu\"]', 'click', () => document.body.classList.toggle('nav-open'));\n    SS.bindOnce(document, '[data-action=\"theme\"]', 'click', () => {\n      SS.savePrefs({ theme: state.prefs.theme === 'dark' ? 'light' : 'dark' });\n      renderRoute();\n    });\n    SS.bindOnce(document, '[data-action=\"lang\"]', 'click', async () => {\n      const lang = state.prefs.lang === 'hi' ? 'en' : 'hi';\n      await SS.savePrefs({ lang });\n      if (state.user) {\n        try {\n          const result = await SS.api('/user/profile', { method: 'PATCH', body: { lang } });\n          SS.saveSession(result);\n        } catch (_) { /* language still saved locally */ }\n      }\n      SS.toast(lang === 'hi' ? 'भाषा हिंदी में बदली गई' : 'Language set to English', 'success');\n      renderRoute();\n    });\n    SS.bindOnce(document, '[data-action=\"logout\"]', 'click', async () => {\n      const sure = await SS.confirmDialog('Do you want to sign out of SurakshaSetu?', 'Sign out');\n      if (!sure) return;\n      try { await SS.api('/auth/logout', { method: 'POST' }); } catch (_) { /* local sign-out anyway */ }\n      SS.clearSession();\n      location.hash = '#/auth';\n      renderRoute();\n    });\n  }\n\n  async function renderRoute() {\n    const name = currentPageName();\n    const page = SS.pages[name];\n    const app = document.getElementById('app');\n    if (!app) return;\n\n    if (!page) {\n      app.innerHTML = '<div class=\"view\">' + SS.empty('This page does not exist.', 'info') +\n        '<div class=\"center mt-2\"><button class=\"btn primary\" data-nav=\"home\">Go to dashboard</button></div></div>';\n      SS.bindOnce(app, '[data-nav]', 'click', () => SS.go('home'));\n      return;\n    }\n\n    if (page.authScreen || !state.user) {\n      const target = page.authScreen ? page : SS.pages.auth;\n      app.innerHTML = '<div id=\"authRoot\"></div>';\n      const root = document.getElementById('authRoot');\n      try {\n        root.innerHTML = await target.render(name);\n        if (target.mount) await target.mount(root, name);\n      } catch (err) {\n        root.innerHTML = '<div style=\"padding:40px;text-align:center\">' + SS.esc(err.message) + '</div>';\n      }\n      state.currentPage = name;\n      return;\n    }\n\n    if (name === 'municipal' && state.user.role !== 'admin') {\n      app.innerHTML = shell({ title: 'Access restricted', sub: 'Municipal administrators only' }) +\n        '<script></script>';\n      // shell() replaces #app content, so re-fetch view\n      const view = document.getElementById('view');\n      if (view) view.innerHTML = '<div class=\"card\"><div class=\"card-body\">' +\n        SS.empty('This area is available to MCD administrators only.', 'lock') + '</div></div>';\n      bindShell();\n      state.currentPage = name;\n      return;\n    }\n\n    if (name !== 'onboard' && !state.profileComplete && !['auth', 'signup', 'verify', 'forgot', 'reset', 'privacy', 'help'].includes(name)) {\n      SS.go('onboard');\n      return;\n    }\n\n    app.innerHTML = shell(page);\n    bindShell();\n    const view = document.getElementById('view');\n    if (!view) return;\n\n    document.querySelectorAll('.nav-link').forEach((link) => {\n      if (link.getAttribute('data-nav') === name) link.classList.add('active');\n    });\n\n    view.innerHTML = '<div class=\"card\" style=\"padding:26px\"><div class=\"skeleton\" style=\"width:45%;margin-bottom:12px\"></div>' +\n      '<div class=\"skeleton\" style=\"width:80%;margin-bottom:8px\"></div><div class=\"skeleton\" style=\"width:65%\"></div></div>';\n\n    try {\n      const html = await page.render(name);\n      if (currentPageName() !== name) return;\n      view.innerHTML = html;\n      if (page.mount) await page.mount(view, name);\n      state.currentPage = name;\n      window.scrollTo({ top: 0, behavior: 'instant' });\n    } catch (err) {\n      if (currentPageName() !== name) return;\n      view.innerHTML = '<div class=\"card\"><div class=\"card-body\">' +\n        '<h3>Could not load this page</h3><p class=\"muted\">' + SS.esc(err.message) + '</p>' +\n        '<button class=\"btn primary\" data-action=\"retry\">Try again</button></div></div>';\n      SS.bindOnce(view, '[data-action=\"retry\"]', 'click', renderRoute);\n    }\n  }\n\n  async function boot() {\n    SS.applyPrefs();\n    window.__ssRenderRoute = renderRoute;\n\n    if ('serviceWorker' in navigator) {\n      navigator.serviceWorker.register('/sw.js').catch(() => { /* offline support is optional */ });\n    }\n\n    window.addEventListener('hashchange', renderRoute);\n    window.addEventListener('online', async () => {\n      state.online = true;\n      SS.toast('Back online. Syncing saved actions…', 'success');\n      await SS.syncQueue();\n      renderRoute();\n    });\n    window.addEventListener('offline', () => {\n      state.online = false;\n      SS.toast('You are offline. Saved actions will sync later.');\n    });\n\n    if (state.token) {\n      try {\n        const result = await SS.api('/auth/me');\n        SS.saveSession(result);\n      } catch (_) {\n        SS.clearSession();\n      }\n    }\n\n    await renderRoute();\n    if (state.token && state.queue.length && state.online) SS.syncQueue();\n  }\n\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);\n  else boot();\n})();\n"
