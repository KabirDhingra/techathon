;margin:12px 0 8px\">' + esc(scheme.benefit) + '</p>' +\n              '<button class=\"btn sm ghost\" data-details=\"' + esc(scheme.id) + '\">Documents & steps ' + SS.icon('chevron', 12) + '</button>' +\n              '<div class=\"hidden mt-2\" id=\"details-' + esc(scheme.id) + '\">' +\n                '<b class=\"tiny\" style=\"text-transform:uppercase;letter-spacing:.07em;color:var(--muted)\">Documents</b>' +\n                '<ul class=\"tiny mb-1\" style=\"padding-left:18px;margin-top:4px\">' + (scheme.documents || []).map((doc) => '<li>' + esc(doc) + '</li>').join('') + '</ul>' +\n                '<b class=\"tiny\" style=\"text-transform:uppercase;letter-spacing:.07em;color:var(--muted)\">How to apply</b>' +\n                '<ol class=\"tiny mb-1\" style=\"padding-left:18px;margin-top:4px\">' + (scheme.steps || []).map((step) => '<li>' + esc(step) + '</li>').join('') + '</ol>' +\n              '</div>' +\n              '<div class=\"form-actions\"><a class=\"btn sm primary\" href=\"' + esc(scheme.url) + '\" target=\"_blank\" rel=\"noopener\">Official site ' + SS.icon('arrow', 12) + '</a>' +\n                (scheme.delhiOnly ? '<span class=\"badge amber\">Delhi residents</span>' : '<span class=\"badge green\">Pan India</span>') + '</div>' +\n            '</div></div>'\n        ).join('') + '</div>';\n    },\n    async mount(root) {\n      SS.bindAll(root, '[data-details]', 'click', (event) => {\n        const id = event.currentTarget.getAttribute('data-details');\n        const box = root.querySelector('#details-' + id);\n        if (!box) return;\n        box.classList.toggle('hidden');\n        event.currentTarget.innerHTML = box.classList.contains('hidden')\n          ? 'Documents & steps ' + SS.icon('chevron', 12) : 'Hide details ' + SS.icon('chevron', 12);\n      });\n      let onlyEligible = false;\n      SS.bindOnce(root, '#toggleEligible', 'click', (event) => {\n        onlyEligible = !onlyEligible;\n        root.querySelectorAll('[data-scheme]').for