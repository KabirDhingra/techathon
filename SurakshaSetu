              "content": "/* SurakshaSetu — collections, recycling centres, history and rewards */\n'use strict';\n\n(function () {\n  const SS = window.SS;\n  const esc = SS.esc;\n  const MATERIALS = ['Plastic', 'Paper', 'Metal', 'Glass', 'E-waste', 'Cardboard', 'Other'];\n\n  /* ---------- Log collections ---------- */\n  SS.pages.collect = {\n    title: 'Collections',\n    sub: 'Log what you collected and where it went',\n    async render() {\n      const [collections, centres] = await Promise.all([SS.api('/collections'), SS.api('/centres')]);\n      const all = collections.collections || [];\n      const today = all.filter((item) => new Date(item.at).toDateString() === new Date().toDateString());\n      const totalKg = all.reduce((sum, item) => sum + (Number(item.kg) || 0), 0);\n      const todayKg = today.reduce((sum, item) => sum + (Number(item.kg) || 0), 0);\n      const prefill = SS.readJSON('ss_collect_prefill', {});\n      sessionStorage.removeItem('ss_collect_prefill');\n\n      return SS.pageHead('Collection Log', 'Every entry builds your work record and earns points.', 'Work · Collections') +\n        '<div class=\"stat-grid mb-3\">' +\n          '<div class=\"stat\"><div class=\"label\">Today</div><div class=\"value\">' + todayKg.toFixed(1) + ' kg</div><div class=\"foot\">' + today.length + ' entries</div></div>' +\n          '<div class=\"stat\"><div class=\"label\">All time</div><div class=\"value\">' + totalKg.toFixed(1) + ' kg</div><div class=\"foot\">Lifetime total</div></div>' +\n          '<div class=\"stat\"><div class=\"label\">Entries</div><div class=\"value\">' + all.length + '</div><div class=\"foot\">Verified records</div></div>' +\n          '<div class=\"stat\"><div class=\"label\">Points per log</div><div class=\"value\">+10</div><div class=\"foot up\">Added automatically</div></div>' +\n        '</div>' +\n        '<div class=\"grid cols-2\" style=\"align-items:start\">' +\n          '<div class=\"card\"><div class=\"card-body\">' +\n            '<h3 class=\"card-title mb-2\">Log a collection</h3>' +\n            '<form id=\"collectForm\" class=\"stack\">' +\n              '<div class=\"form-grid\">' +\n                '<div class=\"field\"><label>Material</label><select class=\"select\" name=\"material\">' +\n                  MATERIALS.map((material) => '<option ' + (prefill.material === material ? 'selected' : '') + '>' + material + '</option>').join('') +\n                '</select></div>' +\n                '<div class=\"field\"><label>Quantity (kg)</label><input class=\"input\" name=\"kg\" type=\"number\" min=\"0.1\" max=\"5000\" step=\"0.1\" placeholder=\"e.g. 6.5\" required></div>' +\n              '</div>' +\n              '<div class=\"field\"><label>Destination / centre</label>' +\n                '<input class=\"input\" name=\"destination\" list=\"centreList\" placeholder=\"e.g. Rohini Recycling Point\" value=\"' + esc(prefill.destination || '') + '\">' +\n                '<datalist id=\"centreList\">' + (centres.centres || []).map((centre) => '<option value=\"' + esc(centre.name) + '\"></option>').join('') + '</datalist>' +\n              '</div>' +\n              '<div class=\"field\"><label>Location</label><div class=\"row\"><button type=\"button\" class=\"btn sm\" id=\"collectLocation\">' + SS.icon('pin') + ' Add GPS</button>' +\n                '<span class=\"hint\" id=\"collectHint\">Not added</span></div></div>' +\n              '<button class=\"btn primary block\" type=\"submit\">' + SS.icon('plus') + ' Save collection · +10 points</button>' +\n            '</form>' +\n            '<p class=\"hint mt-2\">No signal? The entry is saved on your device and synced later.</p>' +\n          '</div></div>' +\n          '<div class=\"card\"><div class=\"card-head\"><h3 class=\"card-title\">Recent collections</h3>' +\n            '<button class=\"btn sm ghost\" data-nav=\"history\">Full history</button></div><div class=\"card-body tight\">' +\n              (all.length\n                ? all.slice(0, 10).map((item) =>\n                    '<div class=\"row between\" style=\"padding:9px 0;border-bottom:1px dashed var(--line)\">' +\n                      '<div class=\"row\"><span class=\"avatar\" style=\"width:32px;height:32px\">' + SS.icon('recycle', 15) + '</span>' +\n                        '<div><b style=\"font-size:12.5px\">' + esc(item.material) + ' · ' + item.kg + ' kg</b>' +\n                          '<div class=\"hint\">' + esc(item.destination || 'No destination') + '</div></div></div>' +\n                      '<span class=\"tiny muted\">' + SS.timeAgo(item.at) + '</span></div>'\n                  ).join('')\n                : SS.empty('No collections logged yet.', 'box')) +\n          '</div></div>' +\n        '</div>';\n    },\n    async mount(root) {\n      let gps = null;\n      SS.bindOnce(root, '#collectLocation', 'click', async (event) => {\n        event.currentTarget.disabled = true;\n        root.querySelector('#collectHint').textContent = 'Locating…';\n        gps = await SS.geo();\n        root.querySelector('#collectHint').textContent = gps ? gps.lat.toFixed(4) + ', ' + gps.lng.toFixed(4) : 'GPS unavailable — still saved';\n        event.currentTarget.disabled = false;\n      });\n      SS.bindOnce(root, '#collectForm', 'submit', async (event) => {\n        event.preventDefault();\n        const form = event.currentTarget;\n        const button = form.querySelector('button[type=\"submit\"]');\n        button.disabled = true;\n        try {\n          const result = await SS.api('/collections', {\n            method: 'POST', queue: true,\n            body: {\n              material: form.material.value, kg: Number(form.kg.value),\n              destination: form.destination.value.trim(), gps\n            }\n          });\n          SS.toast('Collection logged! +' + result.awarded + ' points.', 'success');\n          SS.go('collect');\n        } catch (err) { SS.toast(err.message, 'error'); button.disabled = false; }\n      });\n      SS.bindAll(root, '[data-nav]', 'click', (event) => SS.go(event.currentTarget.getAttribute('data-nav')));\n    }\n  };\n\n  /* ---------- Nearby centres / recyclers ---------- */\n  SS.pages.recyclers = {\n    title: 'Nearby Centres',\n    sub: 'Verified drop-off points and live recycling locations',\n    async render() {\n      const data = await SS.api('/centres');\n      const centres = data.centres || [];\n      return SS.pageHead('Collection & Recycling Centres', 'Find the nearest drop-off point and plan a safer route.', 'Work · Centres') +\n        '<div class=\"row wrap between mb-2\">' +\n          '<div class=\"row\"><span class=\"badge ' + (data.source === 'live' ? 'green' : 'blue') + '\">' +\n            (data.source === 'live' ? 'Live OpenStreetMap data' : 'Verified Delhi centres') + '</span>' +\n            '<span class=\"hint\">' + centres.length + ' locations</span></div>' +\n          '<button class=\"btn sm primary\" id=\"useLocation\">' + SS.icon('pin') + ' Use my location</button>' +\n        '</div>' +\n        '<div class=\"grid cols-2\" style=\"align-items:start\">' +\n          '<div class=\"card\"><div class=\"card-body\">' +\n            '<div id=\"miniMap\" style=\"height:300px;border-radius:12px;overflow:hidden;background:var(--panel-2);border:1px solid var(--line);position:relative\">' + miniMap(centres, null) + '</div>' +\n            '<p class=\"hint mt-2\">Schematic map — not for navigation. Open a location in your maps app for directions.</p>' +\n          '</div></div>' +\n          '<div class=\"stack\">' + centres.map((centre) =>\n            '<div class=\"card\"><div class=\"card-body\">' +\n              '<div class=\"row between\" style=\"align-items:flex-start\"><div>' +\n                '<b style=\"font-size:13.5px\">' + esc(centre.name) + '</b>' +\n                '<div class=\"hint mt-1\">' + SS.icon('pin', 12) + ' ' + (centre.distance != null ? centre.distance.toFixed(1) + ' km away' : 'Distance unavailable') + '</div>' +\n              '</div>' + (centre.verified ? '<span class=\"badge green\">Verified</span>' : '<span class=\"badge\">Community</span>') + '</div>' +\n              '<div class=\"kv mt-2\"><span>Accepts</span><b>' + esc(centre.materials) + '</b></div>' +\n              '<div class=\"kv\"><span>Hours</span><b>' + esc(centre.hours) + '</b></div>' +\n              '<div class=\"form-actions\"><a class=\"btn sm\" target=\"_blank\" rel=\"noopener\" href=\"https://www.google.com/maps?q=' + centre.lat + ',' + centre.lng + '\">' + SS.icon('map', 13) + ' Directions</a>' +\n                '<button class=\"btn sm primary\" data-centre=\"' + esc(centre.name) + '\">Log collection here</button></div>' +\n            '</div></div>'\n          ).join('') + '</div>' +\n        '</div>';\n    },\n    async mount(root) {\n      SS.bindAll(root, '[data-centre]', 'click', (event) => {\n        SS.writeJSON('ss_collect_prefill', { destination: event.currentTarget.getAttribute('data-centre') });\n        SS.go('collect');\n      });\n      SS.bindOnce(root, '#useLocation', 'click', async (event) => {\n        event.currentTarget.disabled = true;\n        SS.toast('Finding your location…');\n        const pos = await SS.geo();\n        if (!pos) {\n          SS.toast('Location unavailable. Showing verified centres.', 'error');\n          event.currentTarget.disabled = false;\n          return;\n        }\n        try {\n          const data = await SS.api('/centres?lat=' + pos.lat + '&lng=' + pos.lng);\n          const map = root.querySelector('#miniMap');\n          if (map) map.innerHTML = miniMap(data.centres || [], pos);\n          SS.toast('Centres sorted by distance from you.', 'success');\n        } catch (err) { SS.toast(err.message, 'error'); }\n        finally { event.currentTarget.disabled = false; }\n      });\n    }\n  };\n\n  function miniMap(centres, pos) {\n    const points = centres.filter((c) => Number.isFinite(Number(c.lat)) && Number.isFinite(Number(c.lng)));\n    if (!points.length) return '<div class=\"empty\" style=\"height:100%;display:grid;place-items:center\">No locations available</div>';\n    const lats = points.map((c) => Number(c.lat));\n    const lngs = points.map((c) => Number(c.lng));\n    if (pos) { lats.push(pos.lat); lngs.push(pos.lng); }\n    let minLat = Math.min(...lats), maxLat = Math.max(...lats), minLng = Math.min(...lngs), maxLng = Math.max(...lngs);\n    if (maxLat - minLat < 0.01) { minLat -= 0.005; maxLat += 0.005; }\n    if (maxLng - minLng < 0.01) { minLng -= 0.005; maxLng += 0.005; }\n    const pad = 0.15;\n    function xy(lat, lng) {\n      return {\n        x: (pad + (Number(lng) - minLng) / (maxLng - minLng) * (1 - 2 * pad)) * 100,\n        y: (pad + (maxLat - Number(lat)) / (maxLat - minLat) * (1 - 2 * pad)) * 100\n      };\n    }\n    const lines = '<svg viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\" style=\"width:100%;height:100%\">' +\n      '<rect width=\"100\" height=\"100\" fill=\"var(--panel-2)\"/>' +\n      [20, 40, 60, 80].map((n) => '<line x1=\"' + n + '\" y1=\"0\" x2=\"' + n + '\" y2=\"100\" stroke=\"var(--line)\" stroke-width=\".3\"/>' +\n        '<line x1=\"0\" y1=\"' + n + '\" x2=\"100\" y2=\"' + n + '\" stroke=\"var(--line)\" stroke-width=\".3\"/>').join('') +\n      points.map((c) => {\n        const p = xy(c.lat, c.lng);\n        return '<circle cx=\"' + p.x + '\" cy=\"' + p.y + '\" r=\"1.6\" fill=\"' + (c.verified ? '#0f766e' : '#d97706') + '\"/>' +\n          '<text x=\"' + p.x + '\" y=\"' + (p.y - 2.6) + '\" font-size=\"2.5\" text-anchor=\"middle\" fill=\"var(--ink)\">' + SS.esc(String(c.name).slice(0, 16)) + '</text>';\n      }).join('') +\n      (pos ? (() => { const p = xy(pos.lat, pos.lng); return '<circle cx=\"' + p.x + '\" cy=\"' + p.y + '\" r=\"2.2\" fill=\"#c62828\" stroke=\"#fff\" stroke-width=\".6\"/><text x=\"' + p.x + '\" y=\"' + (p.y + 4) + '\" font-size=\"2.4\" text-anchor=\"middle\" fill=\"#c62828\">You</text>'; })() : '') +\n      '</svg>';\n    retur