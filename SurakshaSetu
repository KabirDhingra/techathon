\n        try {\n          const result = await SS.api('/auth/login', {\n            method: 'POST', auth: false,\n            body: { email: form.key.value.trim(), password: form.password.value }\n          });\n          if (result.needsVerification) {\n            verifyState({ key: result.key, purpose: result.purpose, devCode: result.devCode });\n            SS.toast(result.message || 'Please verify your account.');\n            SS.go('verify');\n            return;\n          }\n          SS.saveSession(result);\n          SS.toast('Welcome back, ' + (result.user.name || 'worker') + '!', 'success');\n          SS.go(result.profileComplete ? 'home' : 'onboard');\n        } catch (err) {\n          SS.toast(err.message, 'error');\n        } finally {\n          button.disabled = false;\n        }\n      });\n      const demoButtons = root.querySelectorAll('.demo-note b');\n      demoButtons.forEach((bold) => bold.style.cursor = 'pointer');\n    }\n  };\n\n  /* ---------- Sign up ---------- */\n  SS.pages.signup = {\n    authScreen: true,\n    title: 'Create account',\n    async render() {\n      return shell(\n        '<h2>Create your account</h2><p class=\"muted\">It takes less than a minute. Your details stay private.</p>' +\n        '<div class=\"tabs\"><button data-tab=\"login\">Sign in</button>' +\n        '<button class=\"active\" data-tab=\"signup\">Create account</button></div>' +\n        '<form id=\"signupForm\" class=\"stack\">' +\n          '<div class=\"field\"><label>Full name</label><input class=\"input\" name=\"name\" placeholder=\"e.g. Ramesh Kumar\" required minlength=\"2\"></div>' +\n          '<div class=\"field\"><label>Email address</label><input class=\"input\" name=\"email\" type=\"email\" placeholder=\"you@example.com\" required></div>' +\n          '<div class=\"field\"><label>Password</label><input class=\"input\" name=\"password\" type=\"password\" placeholder=\"At least 6 characters\" required minlength=\"6\"></div>' +\n          '<div class=\"field\"><label>Preferred language</label><select class=\"select\" name=\"lang\"><option value=\"en\">English</option><option value=\"hi\">हिन्दी (Hindi)</option></select></div>' +\n          '<button class=\"btn primary block\" type=\"submit\">Create account ' + SS.icon('arrow') + '</button>' +\n        '</form>' +\n        '<p class=\"hint mt-2\">By continuing you agree to use SurakshaSetu responsibly. Your phone number is never shown on your public ID.</p>' +\n        '<div class=\"row between mt-2\"><button class=\"btn sm ghost\" data-tab=\"login\">Already have an account?</button></div>'\n      );\n    },\n    async mount(root) {\n      SS.bindAll(root, '[data-tab]', 'click', (event) => SS.go(event.currentTarget.getAttribute('data-tab')));\n      SS.bindOnce(root, '#signupForm', 'submit', async (event) => {\n        event.preventDefault();\n        const form = event.currentTarget;\n        const button = form.querySelector('button[type=\"submit\"]');\n        button.disabled = true;\n        try {\n          const result = await SS.api('/auth/signup', {\n            method: 'POST', auth: false,\n            body: { name: form.name.value.trim(), email: form.email.value.trim(), password: form.password.value, lang: form.lang.value }\n          });\n          verifyState({ key: result.key, purpose: result.purpose, devCode: result.devCode });\n          SS.toast(result.message || 'Account created. Verify to continue.', 'success');\n          SS.go('verify');\n        } catch (err) {\n          SS.toast(err.message, 'error');\n        } finally {\n          button.disabled = false;\n        }\n      });\n    }\n  };\n\n  /* ---------- OTP verification ---------- */\n  SS.pages.verify = {\n    authScreen: true,\n    title: 'Verify account',\n    async render() {\n      const saved = getVerifyState();\n      let boxes = '';\n      for (let i = 0; i < 6; i += 1) {\n        boxes += '<input class=\"otp-box\" type=\"text\" inputmode=\"numeric\" maxlength=\"1\" a