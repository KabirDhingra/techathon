              "content": "/* SurakshaSetu — authentication, OTP and onboarding screens */\n'use strict';\n\n(function () {\n  const SS = window.SS;\n  const esc = SS.esc;\n\n  function shell(content) {\n    return '<div class=\"auth-shell\">' +\n      '<aside class=\"auth-aside\">' +\n        '<div class=\"brand\" style=\"padding:0;border:0\"><div class=\"brand-mark\">SS</div>' +\n          '<div class=\"brand-name\">SurakshaSetu<small>SAFETY · ID · OPPORTUNITY</small></div></div>' +\n        '<h1>Safety first.<br>Every single shift.</h1>' +\n        '<p>A practical companion for informal waste workers — hazard guidance, emergency help, a verified digital ID and a direct line to opportunities.</p>' +\n        '<div class=\"auth-features\">' +\n          '<div class=\"auth-feature\">' + SS.icon('shield') + '<span>Hazardaware scanning and daily safety checks</span></div>' +\n          '<div class=\"auth-feature\">' + SS.icon('sos') + '<span>One-touch SOS with location sharing</span></div>' +\n          '<div class=\"auth-feature\">' + SS.icon('id') + '<span>Private, verifiable worker identity</span></div>' +\n          '<div class=\"auth-feature\">' + SS.icon('gift') + '<span>Welfare schemes, health camps and rewards</span></div>' +\n        '</div>' +\n        '<p class=\"tiny\" style=\"margin-top:34px;color:#63808f\">Built for workers in Delhi · Works offline · Hindi & English</p>' +\n      '</aside>' +\n      '<main class=\"auth-main\"><div class=\"auth-card\">' + content + '</div></main>' +\n    '</div>';\n  }\n\n  function demoNote(text) {\n    return '<div class=\"demo-note\">' + text + '</div>';\n  }\n\n  function verifyState(data) {\n    sessionStorage.setItem('ss_verify', JSON.stringify(data));\n  }\n\n  function getVerifyState() {\n    try { return JSON.parse(sessionStorage.getItem('ss_verify') || '{}'); } catch (_) { return {}; }\n  }\n\n  /* ---------- Sign in ---------- */\n  SS.pages.auth = {\n    authScreen: true,\n    title: 'Sign in',\n    async rende