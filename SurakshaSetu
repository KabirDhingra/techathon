 '<button class=\"btn sm block mt-3 ' + (camp.registered ? '' : 'primary') + '\" data-camp=\"' + esc(camp.id) + '\" data-registered=\"' + (camp.registered ? '1' : '0') + '\">' +\n              (camp.registered ? 'Cancel registration' : 'Register for free') + '</button>' +\n          '</div></div>'\n        ).join('') + '</div>' +\n        '<div class=\"grid cols-2 mt-3\">' +\n          '<div class=\"card\"><div class=\"card-body\"><h3 class=\"card-title mb-2\">Before you go</h3>' +\n            '<ul class=\"tiny\" style=\"padding-left:18px\"><li>Bring your digital ID or Aadhaar if you have it.</li>' +\n            '<li>Carry your previous prescriptions and glasses.</li>' +\n            '<li>Ask for a printed report and keep it for future visits.</li></ul></div></div>' +\n          '<div class=\"card\"><div class=\"card-body\"><h3 class=\"card-title mb-2\">Heat and hydration</h3>' +\n            '<p class=\"hint\">Drink water every 30 minutes in summer. If you feel dizzy, sit in shade, loosen clothing, sip ORS and call 108 if you do not improve.</p>' +\n            '<button class=\"btn sm mt-2\" data-nav=\"ai\">Ask AI Saathi for more tips</button></div></div>' +\n        '</div>';\n    },\n    async mount(root) {\n      SS.bindAll(root, '[data-camp]', 'click', async (event) => {\n        const button = event.currentTarget;\n        const id = button.getAttribute('data-camp');\n        const registered = button.getAttribute('data-registered') === '1';\n        if (registered) {\n          const sure = await SS.confirmDialog('Cancel your registration for this camp?', 'Cancel registration');\n          if (!sure) return;\n        }\n        button.disabled = true;\n        try {\n          await SS.api('/camps/' + encodeURIComponent(id) + '/register', { method: registered ? 'DELETE' : 'POST' });\n          SS.toast(registered ? 'Registration cancelled.' : 'Registered successfully!', 'success');\n          SS.go('health');\n        } catch (err) { SS.toast(err.message, 'error'); button.disabled = false; }\n      });\n      SS.bindAll(root, '[data-nav]', 'click', (event) => SS.go(event.currentTarget.getAttribute('data-nav')));\n    }\n  };\n\n  /* ---------- Community ---------- */\n  SS.pages.community = {\n    title: 'Community',\n    sub: 'Shared safety tips and collective progress',\n    async render() {\n      const data = await SS.api('/community');\n      const localTips = SS.readJSON('ss_my_tips', []);\n      const stats = data.stats || {};\n      return SS.pageHead('Community', 'Learn from other workers and see what we achieve together.', 'Opportunities · Community') +\n        '<div class=\"stat-grid mb-3\">' +\n          '<div class=\"stat\"><div class=\"label\">Active workers</div><div class=\"value\">' + (stats.workers || 0) + '</div></div>' +\n          '<div class=\"stat\"><div class=\"label\">Material recovered</div><div class=\"value\">' + (stats.collectedKg || 0) + ' <span style=\"font-size:13px;color:var(--muted)\">kg</span></div></div>' +\n          '<div class=\"stat\"><div class=\"label\">Hazards flagged</div><div class=\"value\">' + (stats.hazardsFound || 0) + '</div></div>' +\n          '<div class=\"stat\"><div class=\"label\">Incidents reported</div><div class=\"value\">' + (stats.incidents || 0) + '</div></div>' +\n        '</div>' +\n        '<div class=\"grid cols-2\" style=\"align-items:start\">' +\n          '<div class=\"card\"><div class=\"card-head\"><h3 class=\"card-title\">Safety tips from the community</h3></div>' +\n            '<div class=\"card-body\">' +\n              (data.tips || []).map((tip, index) =>\n                '<div class=\"row\" style=\"padding:9px 0;border-bottom:1px dashed var(--line);align-items:flex-start\">' +\n                  '<span class=\"badge blue\">' + (index + 1) + '</span><span style=\"font-size:12.5px\">' + esc(tip) + '</span></div>'\n              ).join('') +\n              (localTips.length ? '<h4 class=\"section-title\">Your submitted tips</h4>' + localTips.map((tip) =>\n                '<div class=\"row\" style=\"padding:8px 0;border-bottom:1px dashed var(--line)\">' +\n                  '<span class=\"badge amber\">Pending review</span><span style=\"font-size:12.5px\">' + esc(tip.text) + '</span></div>'\n              ).join('') : '') +\n            '</div></div>' +\n          '<div class=\"stack\">' +\n            '<div class=\"card\"><div class=\"card-body\">' +\n              '<h3 class=\"card-title mb-2\">Share a tip</h3>' +\n              '<p class=\"hint\">Tips are reviewed before they appear for everyone. Be practical and respectful.</p>' +\n              '<form id=\"tipForm\" class=\"stack mt-2\"><textarea class=\"textarea\" id=\"tipText\" maxlength=\"300\" placeholder=\"e.g. Keep a wet cloth over your nose while sorting dry paper…\" required></textarea>' +\n                '<button class=\"btn primary\" type=\"submit\">Submit tip for review</button></form>' +\n            '</div></div>' +\n            '<div class=\"card\" style=\"border-left:4px solid var(--brand)\"><div class=\"card-body\">' +\n              '<h3 class=\"card-title mb-2\">Together we are safer</h3>' +\n              '<p class=\"hint\">Every hazard report removes a danger for the next worker. Every collection logged helps the city plan better routes and centres.</p>' +\n              '<button class=\"btn sm primary mt-2\" data-nav=\"incident\">Report a hazard</button>' +\n            '</div></div>' +\n          '</div>' +\n        '</div>';\n    },\n    async mount(root) {\n      SS.bindOnce(root, '#tipForm', 'submit', (event) => {\n        event.preventDefault();\n        const input = root.querySelector('#tipText');\n        const text = input.value.trim();\n        if (!text) return;\n        const tips = SS.readJSON('ss_my_tips', []);\n        tips.unshift({ text, at: Date.now() });\n        SS.writeJSON('ss_my_tips', tips.slice(0, 20));\n        input.value = '';\n        SS.toast('Tip submitted for review. Thank you!', 'success');\n    