    },\n    async mount(root) {\n      const button = root.querySelector('#sosButton');\n      const count = root.querySelector('#sosCount');\n      const status = root.querySelector('#sosStatus');\n      let timer = null;\n      let holding = false;\n      let fired = false;\n\n      function stop() {\n        if (timer) clearInterval(timer);\n        timer = null;\n        holding = false;\n        button.classList.remove('holding');\n        if (!fired) { count.textContent = '3.0'; status.textContent = 'Cancelled. Hold again when ready.'; }\n      }\n\n      async function fire() {\n        fired = true;\n        stop();\n        status.textContent = 'Sending alert…';\n        button.disabled = true;\n        try {\n          const gps = await SS.geo();\n          const result = await SS.api('/sos', {\n            method: 'POST', queue: true,\n            body: { gps, description: 'Emergency SOS from ' + (SS.state.user.name || 'a worker') + ' · ' + (SS.state.user.area || 'Delhi') }\n          });\n          const links = result.links || {};\n          SS.modal(\n            '<div class=\"center\">' +\n              '<span class=\"avatar\" style=\"width:54px;height:54px;background:var(--danger-soft);color:var(--danger);margin:0 auto 10px\">' + SS.icon('sos', 24) + '</span>' +\n              '<h3>SOS alert sent</h3><p class=\"muted\">Alert <b>' + esc(result.incident.id) + '</b> is recorded' +\n              (gps ? ' with your location.' : ' without location (GPS unavailable).') + '</p>' +\n              '<div class=\"form-actions\" style=\"justify-content:center\">' +\n                (links.whatsapp ? '<a class=\"btn primary\" href=\"' + esc(links.whatsapp) + '\" target=\"_blank\" rel=\"noopener\">Share on WhatsApp</a>' : '') +\n                (links.sms ? '<a class=\"btn\" href=\"' + esc(links.sms) + '\">Send SMS</a>' : '') +\n                '<a class=\"btn danger\" href=\"' + esc(links.call || 'tel:112') + '\">Call 112</a>' +\n              '</div>' +\n       