              "content": "/* SurakshaSetu — reference UI system (green, mobile-first) */\n:root {\n  --bg: #f3f7f4;\n  --panel: #ffffff;\n  --panel-2: #f6faf7;\n  --ink: #0f231a;\n  --muted: #5d7268;\n  --line: #e1ebe5;\n  --brand: #0f8f45;\n  --brand-dark: #0a6f34;\n  --brand-deep: #073d1f;\n  --brand-bright: #22c55e;\n  --brand-soft: #e6f7ed;\n  --brand-tint: #d3f0de;\n  --amber: #d97706;\n  --amber-soft: #fef3c7;\n  --danger: #d92d20;\n  --danger-soft: #fee9e7;\n  --blue: #2563eb;\n  --blue-soft: #e7efff;\n  --shadow: 0 1px 2px rgba(16, 40, 27, .04), 0 12px 28px -16px rgba(16, 40, 27, .22);\n  --shadow-lift: 0 18px 40px -22px rgba(10, 111, 52, .55);\n  --radius: 18px;\n  --radius-sm: 12px;\n  --sidebar: 252px;\n  --topbar: 66px;\n}\n\nbody.theme-dark {\n  --bg: #08110d;\n  --panel: #0f1c16;\n  --panel-2: #13231b;\n  --ink: #e7f2ec;\n  --muted: #93a99e;\n  --line: #1e3328;\n  --brand: #34d17a;\n  --brand-dark: #22b866;\n  --brand-deep: #062312;\n  --brand-bright: #4ade80;\n  --brand-soft: #10301f;\n  --brand-tint: #14402a;\n  --amber: #fbbf24;\n  --amber-soft: #3a2d12;\n  --danger: #f87171;\n  --danger-soft: #3c1e22;\n  --blue: #7ab0ff;\n  --blue-soft: #1b2c48;\n  --shadow: 0 1px 2px rgba(0, 0, 0, .3), 0 12px 30px rgba(0, 0, 0, .22);\n  --shadow-lift: 0 18px 40px -20px rgba(0, 0, 0, .7);\n}\n\nbody.high-contrast {\n  --bg: #000;\n  --panel: #000;\n  --panel-2: #0a0a0a;\n  --ink: #fff;\n  --muted: #f2f2f2;\n  --line: #fff;\n  --brand: #ffe08a;\n  --brand-dark: #ffe08a;\n  --brand-deep: #000;\n  --brand-bright: #ffe08a;\n  --brand-soft: #1a1a00;\n  --brand-tint: #262600;\n  --shadow: none;\n  --shadow-lift: none;\n}\nbody.high-contrast .card, body.high-contrast .input, body.high-contrast .btn,\nbody.high-contrast .quick-tile, body.high-contrast .centre-card { border-width: 2px; }\nbody.high-contrast a, body.high-contrast button { text-decoration: none; }\nbody.high-contrast .btn:focus, body.high-contrast .nav-link:focus,\nbody.high-contrast .input:focus, body.high-contrast .quick-tile:focus { outline: 3px solid var(--brand); outline-offset: 2px; }\nbody.high-contrast .muted, body.high-contrast .hint, body.high-contrast .tiny { color: #f5f5f5; }\nbody.high-contrast .badge { border: 1px solid currentColor; }\nbody.high-contrast .app-hero, body.high-contrast .ai-cta { border: 2px solid #fff; }\n\n* { box-sizing: border-box; }\nhtml, body { margin: 0; min-height: 100%; }\nbody {\n  background: var(--bg);\n  color: var(--ink);\n  font: 14px/1.5 \"Inter\", \"Segoe UI\", system-ui, -apple-system, Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n  text-rendering: optimizeLegibility;\n}\na { color: var(--brand); text-decoration: none; }\nbutton, input, select, textarea { font: inherit; }\nbutton { cursor: pointer; }\nsvg { display: block; }\nh1, h2, h3, h4, p { margin-top: 0; }\n::-webkit-scrollbar { height: 9px; width: 9px; }\n::-webkit-scrollbar-thumb { background: var(--line); border-radius: 9px; }\n::selection { background: var(--brand-tint); color: var(--brand-deep); }\n\n.boot-screen { min-height: 100vh; display: grid; place-content: center; text-align: center; color: var(--muted); }\n.boot-mark { width: 58px; height: 58px; margin: 0 auto 12px; border-radius: 18px; background: linear-gradient(140deg, var(--brand-bright), var(--brand-dark)); color: #fff; display: grid; place-items: center; font-weight: 900; font-size: 18px; letter-spacing: -.05em; box-shadow: var(--shadow-lift); }\n\n/* ---------- Layout ---------- */\n.layout { min-height: 100vh; display: flex; }\n.sidebar {\n  width: var(--sidebar); position: fixed; inset: 0 auto 0 0; z-index: 40;\n  background: var(--panel); color: var(--ink); display: flex; flex-direction: column;\n  border-right: 1px solid var(--line);\n}\n.brand { display: flex; align-items: center; gap: 11px; padding: 20px 18px 18px; border-bottom: 1px solid var(--line); }\n.brand-mark {\n  width: 40px; height: 40px; border-radius: 13px; flex: none;\n  background: linear-gradient(145deg, var(--brand-bright), var(--brand-dark));\n  color: #fff; display: grid; place-items: center; font-weight: 900; letter-spacing: -.06em;\n  box-shadow: 0 8px 18px -8px rgba(15, 143, 69, .8);\n}\n.brand-mark.sm { width: 34px; height: 34px; border-radius: 11px; font-size: 13px; }\n.brand-name { font-weight: 850; font-size: 15px; color: var(--ink); line-height: 1.1; letter-spacing: -.02em; }\n.brand-name small { display: block; font-size: 9px; letter-spacing: .15em; font-weight: 800; color: var(--brand); margin-top: 4px; }\n.nav-scroll { flex: 1; overflow-y: auto; padding: 14px 12px 20px; }\n.nav-label { padding: 14px 12px 6px; font-size: 10px; letter-spacing: .14em; font-weight: 800; color: var(--muted); text-transform: uppercase; }\n.nav-link {\n  width: 100%; display: flex; align-items: center; gap: 11px; padding: 10px 12px; margin: 2px 0;\n  border: 0; border-radius: 12px; background: transparent; color: var(--muted); font-weight: 650; font-size: 13px; text-align: left;\n  transition: background .15s, color .15s;\n}\n.nav-link svg { width: 18px; height: 18px; flex: none; }\n.nav-link:hover { background: var(--panel-2); color: var(--ink); }\n.nav-link.active { background: var(--brand-soft); color: var(--brand-dark); font-weight: 800; }\n.nav-link.active svg { color: var(--brand); }\n.nav-badge { margin-left: auto; font-size: 10px; background: var(--danger); color: #fff; border-radius: 99px; padding: 1px 7px; font-weight: 800; }\n.sidebar-foot { padding: 14px 18px; border-top: 1px solid var(--line); font-size: 11px; color: var(--muted); }\n.sidebar-foot b { color: var(--ink); }\n\n.main { flex: 1; margin-left: var(--sidebar); min-width: 0; }\n.topbar {\n  position: sticky; top: 0; z-index: 30; min-height: var(--topbar); background: color-mix(in srgb, var(--panel) 92%, transparent);\n  backdrop-filter: saturate(1.4) blur(10px);\n  border-bottom: 1px solid var(--line); display: flex; align-items: center; gap: 12px; padding: 0 24px;\n}\n.topbar-brand { display: none; align-items: center; gap: 10px; min-width: 0; }\n.topbar-brand b { display: block; font-size: 15px; font-weight: 850; letter-spacing: -.02em; line-height: 1.15; }\n.topbar-brand small { display: block; font-size: 10px; color: var(--muted); font-weight: 600; letter-spacing: .02em; }\n.topbar-title { font-size: 16px; font-weight: 800; letter-spacing: -.02em; }\n.topbar-title small { display: block; font-weight: 500; font-size: 11px; color: var(--muted); }\n.topbar-actions { margin-left: auto; display: flex; align-items: center; gap: 8px; }\n.icon-btn {\n  height: 36px; min-width: 36px; border: 1px solid var(--line); background: var(--panel); color: var(--ink);\n  border-radius: 11px; display: grid; place-items: center; padding: 0 9px; font-weight: 700; font-size: 12px;\n  transition: border-color .15s, color .15s, background .15s;\n}\n.icon-btn svg { width: 17px; height: 17px; }\n.icon-btn:hover { border-color: var(--brand); color: var(--brand); }\n.menu-btn { display: none; }\n.user-chip { display: flex; align-items: center; gap: 9px; padding-left: 9px; border-left: 1px solid var(--line); }\n.avatar { width: 34px; height: 34px; border-radius: 11px; background: var(--brand-soft); color: var(--brand-dark); display: grid; place-items: center; font-weight: 800; overflow: hidden; flex: none; }\n.avatar img { width: 100%; height: 100%; object-fit: cover; }\n.user-chip .who { font-size: 12px; font-weight: 700; line-height: 1.2; }\n.user-chip .who small { display: block; font-size: 10px; color: var(--muted); font-weight: 600; }\n.view { padding: 22px 24px 60px; max-width: 1280px; }\n.page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 16px; flex-wrap: wrap; }\n.page-title { font-size: 23px; font-weight: 850; letter-spacing: -.03em; margin: 0 0 3px; }\n.page-sub { color: var(--muted); margin: 0; font-size: 13px; }\n.crumbs { font-size: 10px; color: var(--brand); margin-bottom: 7px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }\n\n/* ---------- Pills ---------- */\n.offline-pill, .lang-pill {\n  display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; padding: 6px 11px;\n  font-size: 10.5px; font-weight: 800; letter-spacing: .04em; border: 1px solid var(--line);\n  background: var(--panel); color: var(--muted); white-space: nowrap;\n}\n.offline-pill { text-transform: uppercase; letter-spacing: .09em; }\n.offline-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brand-bright); box-shadow: 0 0 0 3px var(--brand-soft); }\n.offline-pill.off { color: var(--amber); border-color: var(--amber-soft); background: var(--amber-soft); }\n.offline-pill.off .dot { background: var(--amber); box-shadow: none; }\n.lang-pill { color: var(--ink); cursor: pointer; }\n.lang-pill svg { width: 14px; height: 14px; color: var(--brand); }\n.lang-pill:hover { border-color: var(--brand); }\n\n/* ---------- Primitives ---------- */\n.card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }\n.card-head { padding: 16px 18px 0; display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n.card-title { font-size: 14px; font-weight: 800; margin: 0; letter-spacing: -.01em; }\n.card-body { padding: 16px 18px 18px; }\n.card-body.tight { padding: 12px 14px; }\n.grid { display: grid; gap: 14px; }\n.cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n.cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n.cols-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n.stat-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }\n.stat { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; box-shadow: var(--shadow); }\n.stat .label { color: var(--muted); font-size: 10.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }\n.stat .value { font-size: 26px; font-weight: 850; letter-spacing: -.04em; margin-top: 5px; }\n.stat .foot { font-size: 11px; color: var(--muted); margin-top: 4px; }\n.stat .foot.up { color: var(--brand); font-weight: 700; }\n.row { display: flex; align-items: center; gap: 10px; }\n.between { justify-content: space-between; }\n.wrap { flex-wrap: wrap; }\n.stack { display: flex; flex-direction: column; gap: 12px; }\n.section-title { font-size: 15px; font-weight: 850; letter-spacing: -.02em; margin: 22px 0 11px; display: flex; align-items: center; gap: 8px; }\n.muted { color: var(--muted); }\n.tiny { font-size: 11px; }\n.center { text-align: center; }\n.hidden { display: none !important; }\n.mt-1 { margin-top: 6px; } .mt-2 { margin-top: 12px; } .mt-3 { margin-top: 18px; }\n.mb-1 { margin-bottom: 6px; } .mb-2 { margin-bottom: 12px; } .mb-3 { margin-bottom: 18px; }\n.truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n.btn {\n  display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid var(--line);\n  background: var(--panel); color: var(--ink); border-radius: 12px; padding: 10px 16px; font-weight: 750; font-size: 13px;\n  transition: transform .12s, filter .12s, background .12s, border-color .12s;\n}\n.btn svg { width: 16px; height: 16px; }\n.btn:hover { filter: brightness(.98); border-color: var(--brand-tint); }\n.btn:active { transform: translateY(1px); }\n.btn:disabled { opacity: .5; cursor: not-allowed; }\n.btn.primary { background: var(--brand); border-color: var(--brand); color: #fff; box-shadow: 0 8px 18px -12px rgba(15, 143, 69, .9); }\n.btn.primary:hover { background: var(--brand-dark); border-color: var(--brand-dark); }\n.btn.danger { background: var(--danger); border-color: var(--danger); color: #fff; }\n.btn.amber { background: var(--amber); border-color: var(--amber); color: #fff; }\n.btn.ghost { background: transparent; }\n.btn.light { background: #fff; border-color: #fff; color: var(--brand-dark); border-radius: 999px; }\n.btn.light:hover { background: #eafff1; border-color: #eafff1; }\n.btn.hero-ghost { background: rgba(255,255,255,.14); border-color: rgba(255,255,255,.34); color: #fff; border-radius: 999px; }\n.btn.hero-ghost:hover { background: rgba(255,255,255,.22); }\n.btn.sm { padding: 7px 11px; font-size: 12px; border-radius: 9px; }\n.btn.block { width: 100%; }\n.btn.icon-only { padding: 9px; }\n\n.badge { display: inline-flex; align-items: center; gap: 5px; border-radius: 999px; padding: 3px 9px; font-size: 10.5px; font-weight: 800; text-transform: capitalize; background: var(--panel-2); color: var(--muted); border: 1px solid var(--line); }\n.badge.green { background: var(--brand-soft); color: var(--brand-dark); border-color: transparent; }\n.badge.amber { background: var(--amber-soft); color: var(--amber); border-color: transparent; }\n.badge.red { background: var(--danger-soft); color: var(--danger); border-color: transparent; }\n.badge.blue { background: var(--blue-soft); color: var(--blue); border-color: transparent; }\n.badge.hollow { background: transparent; }\n.dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; display: inline-block; }\n\n.field { display: flex; flex-direction: column; gap: 6px; }\n.field label { font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); }\n.input, .textarea, .select {\n  width: 100%; border: 1px solid var(--line); background: var(--panel); color: var(--ink); border-radius: 12px;\n  padding: 11px 13px; outline: none; transition: border .15s, box-shadow .15s;\n}\n.input:focus, .textarea:focus, .select:focus { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }\n.textarea { min-height: 90px; resize: vertical; }\n.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }\n.form-actions { display: flex; gap: 9px; margin-top: 18px; flex-wrap: wrap; }\n.error { color: var(--danger); font-size: 12px; font-weight: 600; }\n.hint { color: var(--muted); font-size: 11.5px; }\n.check-row { display: flex; align-items: flex-start; gap: 11px; padding: 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); cursor: pointer; }\n.check-row.done { border-color: var(--brand); background: var(--brand-soft); }\n.check-box { width: 24px; height: 24px; border-radius: 8px; border: 2px solid var(--line); display: grid; place-items: center; flex: none; color: transparent; }\n.check-row.done .check-box { background: var(--brand); border-color: var(--brand); color: #fff; }\n.toggle { width: 44px; height: 25px; border-radius: 99px; border: 0; background: var(--line); position: relative; flex: none; transition: background .2s; }\n.toggle::after { content: ''; position: absolute; width: 19px; height: 19px; border-radius: 50%; background: #fff; top: 3px; left: 3px; transition: left .2s; box-shadow: 0 1px 3px rgba(0,0,0,.2); }\n.toggle.on { background: var(--brand); }\n.toggle.on::after { left: 22px; }\n\n.progress { height: 8px; border-radius: 99px; background: var(--line); overflow: hidden; }\n.progress span { display: block; height: 100%; background: linear-gradient(90deg, var(--brand-dark), var(--brand-bright)); border-radius: 99px; transition: width .5s; }\n.timeline { list-style: none; margin: 0; padding: 0; }\n.timeline li { position: relative; padding: 0 0 16px 24px; border-left: 2px solid var(--line); }\n.timeline li:last-child { border-left-color: transparent; }\n.timeline li::before { content: ''; position: absolute; left: -6px; top: 2px; width: 10px; height: 10px; border-radius: 50%; background: var(--line); }\n.timeline li.current::before, .timeline li.done::before { background: var(--brand); }\n.timeline b { font-size: 13px; }\n.timeline small { display: block; color: var(--muted); }\n.kv { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px dashed var(--line); font-size: 13px; }\n.kv:last-child { border-bottom: 0; }\n.kv span:first-child { color: var(--muted); }\n.empty { padding: 34px 16px; text-align: center; color: var(--muted); border: 1px dashed var(--line); border-radius: 14px; }\n.skeleton { background: linear-gradient(90deg, var(--panel-2), var(--line), var(--panel-2)); background-size: 200% 100%; animation: shimmer 1.3s infinite; border-radius: 8px; height: 14px; }\n@keyframes shimmer { to { background-position: -200% 0; } }\n\n.table-wrap { overflow-x: auto; }\ntable.data { width: 100%; border-collapse: collapse; font-size: 12.5px; }\ntable.data th { text-align: left; padding: 10px 12px; color: var(--muted); font-size: 10px; text-transform: uppercase; letter-spacing: .08em; border-bottom: 1px solid var(--line); white-space: nowrap; }\ntable.data td { padding: 11px 12px; border-bottom: 1px solid var(--line); vertical-align: middle; }\ntable.data tr:last-child td { border-bottom: 0; }\ntable.data tbody tr:hover { background: var(--panel-2); }\n\n/* ---------- Home: hero + quick actions ---------- */\n.app-hero {\n  position: relative; overflow: hidden; border-radius: 22px; padding: 22px;\n  background:\n    radial-gradient(120% 140% at 100% 0%, rgba(74, 222, 128, .5) 0%, rgba(74, 222, 128, 0) 55%),\n    linear-gradient(140deg, #0a6f34 0%, #0f8f45 58%, #16a34a 100%);\n  color: #fff; box-shadow: var(--shadow-lift);\n}\n.app-hero::after {\n  content: ''; position: absolute; right: -60px; bottom: -90px; width: 220px; height: 220px;\n  border-radius: 50%; border: 34px solid rgba(255,255,255,.09); pointer-events: none;\n}\n.app-hero .eyebrow { font-size: 9.5px; letter-spacing: .18em; text-transform: uppercase; font-weight: 850; color: #bdf0cf; }\n.app-hero h2 { position: relative; color: #fff; font-size: 25px; line-height: 1.14; letter-spacing: -.035em; margin: 8px 0 7px; max-width: 20ch; }\n.app-hero p { position: relative; color: #cdeed8; font-size: 12.5px; margin: 0 0 16px; max-width: 40ch; }\n.hero-actions { position: relative; display: flex; gap: 8px; flex-wrap: wrap; }\n.hero-actions .btn { padding: 9px 14px; font-size: 12.5px; }\n.hero-meta { position: relative; display: flex; gap: 14px; margin-top: 16px; padding-top: 13px; border-top: 1px solid rgba(255,255,255,.18); }\n.hero-meta div { min-width: 0; }\n.hero-meta b { display: block; font-size: 15px; letter-spacing: -.02em; }\n.hero-meta span { font-size: 10px; color: #bdf0cf; text-transform: uppercase; letter-spacing: .08em; font-weight: 700; }\n\n.ai-cta {\n  width: 100%; display: flex; align-items: center; gap: 13px; text-align: left;\n  border: 1px solid rgba(255,255,255,.14); border-radius: 20px; padding: 15px 16px;\n  background: radial-gradient(120% 160% at 100% 0%, rgba(74,222,128,.45), rgba(74,222,128,0) 60%), linear-gradient(135deg, #0a6f34, #10893f);\n  color: #fff; box-shadow: var(--shadow-lift); transition: transform .15s, filter .15s;\n}\n.ai-cta:hover { transform: translateY(-1px); filter: brightness(1.04); }\n.ai-cta .orb { width: 46px; height: 46px; border-radius: 15px; background: rgba(255,255,255,.16); display: grid; place-items: center; flex: none; }\n.ai-cta b { display: block; font-size: 15px; letter-spacing: -.02em; }\n.ai-cta .hint { color: #c9f0d6; }\n.ai-cta .mic { margin-left: auto; width: 42px; height: 42px; border-radius: 50%; background: #fff; color: var(--brand-dark); display: grid; place-items: center; flex: none; }\n\n.quick-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }\n.quick-tile {\n  display: flex; align-items: center; gap: 11px; text-align: left; width: 100%;\n  background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 13px;\n  box-shadow: var(--shadow); color: var(--ink); transition: transform .14s, border-color .14s;\n}\n.quick-tile:hover { transform: translateY(-1px); border-color: var(--brand-tint); }\n.quick-tile .tile-icon { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; flex: none; }\n.quick-tile b { display: block; font-size: 12.5px; font-weight: 800; letter-spacing: -.01em; line-height: 1.2; }\n.quick-tile span { display: block; font-size: 10.5px; color: var(--muted); margin-top: 2px; }\n.tone-green { background: var(--brand-soft); color: var(--brand-dark); }\n.tone-red { background: var(--danger-soft); color: var(--danger); }\n.tone-amber { background: var(--amber-soft); color: var(--amber); }\n.tone-blue { background: var(--blue-soft); color: var(--blue); }\n.tone-violet { background: #f0e9ff; color: #6d3fd1; }\n.tone-teal { background: #e0f5f2; color: #0d7f74; }\nbody.theme-dark .tone-violet { background: #251b3d; color: #b79bff; }\nbody.theme-dark .tone-teal { background: #0f2f2c; color: #4fd8c9; }\n\n/* ---------- Centres / map ---------- */\n.map-panel { position: relative; border-radius: 20px; overflow: hidden; border: 1px solid var(--line); background: var(--panel-2); min-height: 240px; }\n.map-panel #miniMap { height: 280px; }\n.map-fab {\n  position: absolute; right: 14px; bottom: 14px; width: 48px; height: 48px; border-radius: 50%;\n  border: 0; background: var(--brand-deep); color: #fff; display: grid; place-items: center;\n  box-shadow: 0 10px 24px -10px rgba(0,0,0,.6);\n}\n.map-fab:hover { background: var(--brand-dark); }\n.centre-card { background: var(--panel); border: 1px solid var(--line); border-radius: 16px; padding: 14px 15px; box-shadow: var(--shadow); }\n.centre-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }\n.centre-name { font-size: 13.5px; font-weight: 800; letter-spacing: -.01em; margin: 0; }\n.centre-sub { display: flex; align-items: center; gap: 5px; color: var(--muted); font-size: 11px; margin-top: 3px; }\n.open-pill { display: inline-flex; align-items: center; gap: 5px; background: var(--brand); color: #fff; border-radius: 999px; padding: 3px 10px; font-size: 10px; font-weight: 800; letter-spacing: .02em; flex: none; }\n.open-pill.closed { background: var(--panel-2); color: var(--muted); border: 1px solid var(--line); }\n.centre-tags { display: