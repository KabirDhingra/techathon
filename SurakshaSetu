ss=\"field\"><label>Emergency contact</label><input class=\"input\" name=\"emergencyContact\" inputmode=\"numeric\" maxlength=\"10\" value=\"' + esc(user.emergencyContact || '') + '\" placeholder=\"10-digit mobile\"></div>' +\n              '<div class=\"field\"><label>Language</label><select class=\"select\" name=\"lang\">' +\n                '<option value=\"en\" ' + (user.lang === 'en' ? 'selected' : '') + '>English</option>' +\n                '<option value=\"hi\" ' + (user.lang === 'hi' ? 'selected' : '') + '>हिन्दी</option></select></div>' +\n              '<div class=\"field\"><label>Profile photo</label><input class=\"input\" type=\"file\" id=\"profilePhoto\" accept=\"image/*\"></div>' +\n              '<button class=\"btn primary\" type=\"submit\">Save changes</button>' +\n            '</form>' +\n          '</div></div>' +\n          '<div class=\"stack\">' +\n            '<div class=\"card\"><div class=\"card-body\">' +\n              '<h3 class=\"card-title mb-2\">Mobile verification</h3>' +\n              '<p class=\"hint\">' + (user.phoneVerified && user.phone ? 'Verified mobile: ' + esc(user.phone) : 'Verify your mobile so your emergency contacts can find you.') + '</p>' +\n              '<div class=\"row mt-2\"><input class=\"input\" id=\"profilePhone\" placeholder=\"10-digit mobile\" inputmode=\"numeric\" maxlength=\"10\" value=\"' + esc(user.phone || '') + '\">' +\n                '<button class=\"btn sm\" id=\"profileSendPhone\">Send code</button></div>' +\n              '<div class=\"row mt-2 hidden\" id=\"profilePhoneVerify\"><input class=\"input\" id=\"profilePhoneCode\" placeholder=\"4-digit code\" inputmode=\"numeric\" maxlength=\"4\">' +\n                '<button class=\"btn sm primary\" id=\"profileVerifyPhone\">Verify</button></div>' +\n              '<div class=\"hint mt-2\" id=\"profilePhoneHint\"></div>' +\n            '</div></div>' +\n            '<div class=\"card\"><div class=\"card-body\">' +\n              '<h3 class=\"card-title