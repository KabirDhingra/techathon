              "content": "/* SurakshaSetu — safety centre, scanner, checklist, training, guide, incidents, SOS */\n'use strict';\n\n(function () {\n  const SS = window.SS;\n  const esc = SS.esc;\n\n  const CHECK_ITEMS = [\n    { id: 'gloves', label: 'Thick gloves', icon: 'shield' },\n    { id: 'mask', label: 'Mask or cloth over nose', icon: 'heart' },\n    { id: 'boots', label: 'Closed shoes / boots', icon: 'shield' },\n    { id: 'tongs', label: 'Tongs or grabber', icon: 'briefcase' },\n    { id: 'bags', label: 'Labelled waste bags', icon: 'box' },\n    { id: 'water', label: 'Water and ORS', icon: 'heart' },\n    { id: 'phone', label: 'Charged phone + emergency number', icon: 'phone' }\n  ];\n\n  /* ---------- Safety Centre ---------- */\n  SS.pages.safety = {\n    title: 'Safety Centre',\n    sub: 'Everything you need for a safe shift',\n    async render() {\n      const [emergency, hazards, lessons, checks, tips] = await Promise.all([\n        SS.api('/content/emergency'),\n        SS.api('/content/hazards'),\n        SS.api('/content/lessons'),\n        SS.api('/checklists'),\n        SS.api('/content/tips')\n      ]);\n      const doneLessons = (lessons.lessons || []).filter((item) => item.completed).length;\n      return SS.pageHead('Safety Centre', 'Quick reference for hazards, emergencies and daily habits.', 'Safety') +\n        '<div class=\"card\" style=\"border-left:4px solid var(--danger);margin-bottom:16px\"><div class=\"card-body row wrap between\">' +\n          '<div class=\"row\"><span class=\"avatar\" style=\"background:var(--danger-soft);color:var(--danger)\">' + SS.icon('siren', 20) + '</span>' +\n            '<div><b>In an emergency right now?</b><div class=\"hint\">Hold the SOS button for 3 seconds to alert help with your location.</div></div></div>' +\n          '<button class=\"btn danger\" data-nav=\"sos\">' + SS.icon('sos') + ' Open SOS</button>' +\n        '</div></div>' +\n        '<h2 class=\"section-title\">Emergency numbers</h2>' +\n        '<div class=\"emergency-grid\">' +\n          Object.entries(emergency.numbers || {}).map(([key, value]) =>\n            '<a class=\"call-btn\" href=\"tel:' + esc(value) + '\">' + SS.icon(key === 'police' ? 'shield' : key === 'ambulance' ? 'heart' : key === 'fire' ? 'siren' : 'phone', 18) +\n              '<b>' + esc(value) + '</b><span>' + esc(key.charAt(0).toUpperCase() + key.slice(1)) + '</span></a>'\n          ).join('') +\n        '</div>' +\n        '<div class=\"grid cols-3 mt-3\">' +\n          '<button class=\"card\" data-nav=\"check\" style=\"text-align:left;padding:16px;cursor:pointer\">' +\n            '<div class=\"row\"><span class=\"avatar\">' + SS.icon('check', 18) + '</span><div><b>Daily checklist</b>' +\n              '<div class=\"hint\">' + (checks.doneToday ? 'Completed today ✓' : '7 items · about 1 minute') + '</div></div></div></button>' +\n          '<button class=\"card\" data-nav=\"scanner\" style=\"text-align:left;padding:16px;cursor:pointer\">' +\n            '<div class=\"row\"><span class=\"avatar\">' + SS.icon('scan', 18) + '</span><div><b>Hazard scanner</b>' +\n              '<div class=\"hint\">Identify risk from a photo</div></div></div></button>' +\n          '<button class=\"card\" data-nav=\"training\" style=\"text-align:left;padding:16px;cursor:pointer\">' +\n            '<div class=\"row\"><span class=\"avatar\">' + SS.icon('cap', 18) + '</span><div><b>Training</b>' +\n              '<div class=\"hint\">' + doneLessons + ' of ' + (lessons.lessons || []).length + ' lessons complete</div></div></div></button>' +\n        '</div>' +\n        '<div class=\"grid cols-2 mt-3\" style=\"align-items:start\">' +\n          '<div class=\"card\"><div class=\"card-head\"><h3 class=\"card-title\">Common hazards</h3>' +\n            '<button class=\"btn sm ghost\" data-nav=\"guide\">Full guide</button></div><div class=\"card-body tight\">' +\n              (hazards.hazards || []).slice(0, 5).map((hazard) =>\n                '<div class=\"row between\" style=\"padding:8px 0;border-bottom:1px dashed var(--line)\">' +\n                  '<div class=\"row\"><span class=\"avatar\" style=\"width:30px;height:30px\">' + SS.icon(hazard.icon, 15) + '</span>' +\n                    '<div><b style=\"font-size:12px\">' + esc(hazard.name) + '</b><div class=\"hint\">' + esc(hazard.summary) + '</div></div></div>' +\n                  SS.badge(hazard.risk) + '</div>'\n              ).join('') +\n          '</div></div>' +\n          '<div class=\"card\"><div class=\"card-head\"><h3 class=\"card-title\">Safety habits</h3></div><div class=\"card-body tight\">' +\n            '<ul class=\"timeline\">' + (tips.tips || []).slice(0, 6).map((tip) =>\n              '<li class=\"done\"><b style=\"font-weight:600;font-size:12.5px\">' + esc(tip) + '</b></li>'\n            ).join('') + '</ul>' +\n          '</div></div>' +\n        '</div>';\n    },\n    async mount(root) { SS.bindAll(root, '[data-nav]', 'click', (event) => SS.go(event.currentTarget.getAttribute('data-nav'))); }\n  };\n\n  /* ---------- Hazard scanner ---------- */\n  SS.pages.scanner = {\n    title: 'Hazard Scanner',\n    sub: 'Identify a risk before you touch it',\n    async render() {\n      const [hazards, scans] = await Promise.all([SS.api('/content/hazards'), SS.api('/scans')]);\n      window.__ssHazards = hazards.hazards || [];\n      return SS.pageHead('Hazard Scanner', 'Upload a photo or describe the waste. The result is guidance, not a certified test.', 'Safety · Scanner') +\n        '<div class=\"grid cols-2\" style=\"align-items:start\">' +\n          '<div class=\"card\"><div class=\"card-body\">' +\n            '<div class=\"dropzone\" id=\"dropzone\">' + SS.icon('camera', 34) +\n              '<h3 style=\"margin:6px 0 3px\">Drop a photo here</h3>' +\n              '<p class=\"muted tiny mb-1\">or click to browse · PNG/JPEG up to 9 MB</p>' +\n              '<button type=\"button\" class=\"btn sm primary\" id=\"browseBtn\">Choose photo</button>' +\n              '<input type=\"file\" id=\"scanFile\" accept=\"image/*\" capture=\"environment\" class=\"hidden\">' +\n            '</div>' +\n            '<div class=\"scan-preview hidden mt-2\" id=\"scanPreview\"><img id=\"previewImg\" alt=\"Selected waste photo\"><div class=\"scan-line hidden\" id=\"scanLine\"></div></div>' +\n            '<div class=\"field mt-2\"><label>Describe what you see (optional but helpful)</label>' +\n              '<input class=\"input\" id=\"scanHint\" placeholder=\"e.g. syringe in a red bag, broken glass, battery\"></div>' +\n            '<div class=\"field mt-2\"><label>Or pick a category manually</label>' +\n              '<select class=\"select\" id=\"scanCategory\"><option value=\"\">Let the scanner decide</option>' +\n                (hazards.hazards || []).map((hazard) => '<option value=\"' + esc(hazard.id) + '\">' + esc(hazard.name) + '</option>').join('') +\n              '</select></div>' +\n            '<div class=\"form-actions\"><button class=\"btn primary\" id=\"scanBtn\" disabled>' + SS.icon('scan') + ' Analyse photo</button>' +\n              '<button class=\"btn\" id=\"resetBtn\">Clear</button></div>' +\n            '<p class=\"hint mt-2\">Your photo is processed in the browser for a colour summary and never stored as a file on the server.</p>' +\n          '</div></div>' +\n          '<div class=\"stack\">' +\n            '<div id=\"scanResult\"></div>' +\n            '<div class=\"card\"><div class=\"card-head\"><h3 class=\"card-title\">Recent scans</h3></div><div class=\"card-body tight\">' +\n              ((scans.scans || []).length\n                ? scans.scans.slice(0, 6).map((scan) =>\n                    '<div class=\"row between\" style=\"padding:7px 0;border-bottom:1px dashed var(--line)\">' +\n                      '<div class=\"row\"><span class=\"avatar\" style=\"width:28px;height:28px\">' + SS.icon(scan.icon || 'alert', 14) + '</span>' +\n                        '<div><b style=\"font-size:12px\">' + es