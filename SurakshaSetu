              "content": "'use strict';\n\nconst test = require('node:test');\nconst assert = require('node:assert/strict');\nconst fs = require('node:fs');\nconst os = require('node:os');\nconst path = require('node:path');\n\nconst DATA_DIR = fs.mkdtempSync(path.join(os.tmpdir(), 'ss-api-test-'));\nprocess.env.SS_DATA_DIR = DATA_DIR;\nprocess.env.SS_SECRET = 'test-secret-key';\nprocess.env.SS_DEMO_MODE = 'true';\n\nconst { createServer } = require('../server');\nconst { ensureSeed } = require('../src/seed');\n\nensureSeed();\nconst server = createServer();\n\ntest.before(async () => {\n  await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));\n});\n\ntest.after(async () => {\n  await new Promise((resolve) => server.close(resolve));\n  fs.rmSync(DATA_DIR, { recursive: true, force: true });\n});\n\nfunction base() {\n  return 'http://127.0.0.1:' + server.address().port;\n}\n\nasync function request(method, endpoint, body, token) {\n  const headers = {};\n  if (body !== undefined) headers['Content-Type'] = 'application/json';\n  if (token) headers.Authorization = 'Bearer ' + token;\n  const response = await fetch(base() + '/api' + endpoint, {\n    method,\n    headers,\n    body: body !== undefined ? JSON.stringify(body) : undefined\n  });\n  const data = await response.json();\n  return { status: response.status, data };\n}\n\ntest('health endpoint responds', async () => {\n  const response = await request('GET', '/health');\n  assert.equal(response.status, 200);\n  assert.equal(response.data.status, 'ok');\n});\n\ntest('worker and admin demo accounts can sign in', async () => {\n  const worker = await request('POST', '/auth/login', { email: 'worker@demo.in', password: 'Demo@123' });\n  assert.equal(worker.status, 200);\n  assert.equal(worker.data.user.role, 'worker');\n  assert.ok(worker.data.token);\n\n  const admin = await request('POST', '/auth/login', { email: 'admin@surakshasetu.in', password: 'Admin@123' });\n  assert.equal(admin.status, 200);\n  assert.equal(admin.data.user.role, 'admin');\n\n  const bad = await request('POST', '/auth/login', { email: 'worker@demo.in', password: 'wrong' });\n  assert.equal(bad.status, 401);\n});\n\ntest('protected endpoints require a session token', async () => {\n  const response = await request('GET', '/user/dashboard');\n  assert.equal(response.status, 401);\n});\n\ntest('signup requires OTP verification before login succeeds', async () => {\n  const email = 'new.worker@example.com';\n  const signup = await request('POST', '/auth/signup', {\n    name: 'Priya Sharma', email, password: 'Test@123', lang: 'hi'\n  });\n  assert.equal(signup.status, 200);\n  assert.equal(signup.data.key, email);\n  assert.match(signup.data.devCode, /^\\d{6}$/);\n\n  const blocked = await request('POST', '/auth/login', { email, password: 'Test@123' });\n  assert.equal(blocked.data.needsVerification, true);\n\n  const wrong = await request('POST', '/auth/verify', { key: email, purpose: 'login', code: '000000' });\n  assert.equal(wrong.status, 400);\n\n  const verified = await request('POST', '/auth/verify', { key: email, purpose: 'login', code: signup.data.devCode });\n  assert.equal(verified.status, 200);\n  assert.ok(verified.data.token);\n\n  const after = await request('POST', '/auth/login', { email, password: 'Test@123' });\n  assert.equal(after.status, 200);\n  assert.equal(after.data.user.verified, true);\n});\n\ntest('dashboard, profile and digital ID work for a signed-in worker', async () => {\n  const login = await request('POST', '/auth/login', { email: 'worker@demo.in', password: 'Demo@123' });\n  const token = login.data.token;\n\n  const dash = await request('GET', '/user/dashboard', undefined, token);\n  assert.equal(dash.status, 200);\n  assert.ok(dash.data.stats.collections >= 5);\n\n  const profile = await request('PATCH', '/user/profile', {\n    area: 'Rohini, Delhi', work: 'Waste Collector', emergencyContact: '9876543210'\n  }, token);\n  assert.equal(profile.status, 200);\n\n  const id = await request('GET', '/user/id', undefined, token);\n  assert.equal(id.status, 200);\n  assert.equal(id.data.wid, 'SS-10428');\n  assert.equal(id.data.verified, true);\n\n  const verify = await request('GET', '/id/verify/SS-10428');\n  assert.equal(verify.status, 200);\n  assert.equal(verify.data.phoneHidden, true);\n  assert.equal(verify.data.name, 'Ramesh Kumar');\n\n  const missing = await request('GET', '/id/verify/SS-00000');\n  assert.equal(missing.status, 404);\n});\n\ntest('privacy toggles are persisted and respected by public verification', async () => {\n  const login = await request('POST', '/auth/login', { email: 'worker@demo.in', password: 'Demo@123' });\n  const token = login.data.token;\n\n  const off = await request('PATCH', '/user/privacy', { qrVerification: false }, token);\n  assert.equal(off.status, 200);\n  assert.equal(off.data.privacy.qrVerification, false);\n  const blocked = await request('GET', '/id/verify/SS-10428');\n  assert.equal(blocked.status, 403);\n\n  await request('PATCH', '/user/privacy', { qrVerification: true }, token);\n  const restored = await request('GET', '/id/verify/SS-10428');\n  assert.equal(restored.status, 200);\n});\n\ntest('hazard scan, AI chat, checklist, incident and SOS flows', async () => {\n  const login = await request('POST', '/auth/login', { email: 'worker@demo.in', password: 'Demo@123' });\n  const token = login.data.token;\n\n  const scan = await request('POST', '/scans', {\n    hint: 'syringe in red bag', fileName: 'IMG_0042.jpg',\n    stats: { avgR: 180, avgG: 70, avgB: 60, brightness: 110, contrast: 70 }\n  }, token);\n  assert.equal(scan.status, 200);\n  assert.equal(scan.data.scan.risk, 'high');\n  assert.ok(scan.data.scan.confidence > 50);\n\n  const manual = await request('POST', '/scans', { category: 'sharp-glass' }, token);\n  assert.equal(manual.data.scan.name, 'Broken glass and sharp objects');\n  assert.equal(manual.data.scan.confidence, 100);\n\n  const chat = await request('POST', '/ai/chat', { message: 'broken glass?', lang: 'en' }, token);\n  assert.equal(chat.status, 200);\n  assert.match(chat.data.reply, /glove|tongs|glass/i);\n\n  const hindi = await request('POST', '/ai/chat', { message: 'गर्मी लग रही है', lang: 'hi' }, token);\n  assert.match(hindi.data.reply, /[\\u0900-\\u097f]/);\n\n  const incident = await request('POST', '/incidents', {\n    type: 'Sharp object', severity: 'high', description: 'Broken glass near the collection point.',\n    gps: { lat: 28.68, lng: 77.12 }\n  }, token);\n  assert.equal(incident.status, 200);\n  assert.equal(incident.data.awarded, 15);\n\n  const sos = await request('POST', '/sos', { gps: { lat: 28.68, lng: 77.12 } }, token);\n  assert.equal(sos.status, 200);\n  assert.match(sos.data.links.maps, /google\\.com\\/maps/);\n  assert.match(sos.data.links.call, /tel:112/);\n\n  const synced = await request('POST', '/sos', { synced: true, queuedAt: Date.now() - 60000 }, token);\n  assert.equal(synced.data.awarded, 5);\n});\n\ntest('collection logging, history, centres and camps', async () => {\n  const login = await request('POST', '/auth/login', { email: 'worker@demo.in', password: 'Demo@123' });\n  const token = login.data.token;\n\n  const collection = await request('POST', '/collections', {\n    material: 'Plastic', kg: 7.25, destination: 'Rohini Recycling Point',\n    gps: { lat: 28.688, lng: 77.119 }\n  }, token);\n  assert.equal(collection.status, 200);\n  assert.equal(collection.data.collection.kg, 7.25);\n  assert.equal(collection.data.awarded, 10);\n\n  const history = await request('GET', '/history', undefined, token);\n  assert.ok(history.data.items.some((item) => item.kind === 'collection'));\n\n  const centres = await request('GET', '/centres?lat=28.68&lng=77.12', undefined, token);\n  assert.ok(centres.data.centres.length >= 4);\n\n  const camps = await request('GET', '/content/camps', undefined, token);\n  const campId = camps.data.camps[0].id;\n  const registered = await request('POST', '/camps/' + campId + '/register', {}, token);\n  assert.equal(registered.data.registered, true);\n  const again = await request('GET', '/content/camps', undefined, token);\n  assert.equal(again.data.camps[0].registered, true);\n  await request('DELETE', '/camps/' + campId + '/register', undefined, token);\n});\n\ntest('lessons, progress and scheme eligibility', async () => {\n  const login = await request('POST', '/auth/login', { email: 'worker@demo.in', password: 'Demo@123' });\n  const token = login.data.token;\n\n  const lessons = await request('GET', '/content/lessons', undefined, token);\n  assert.equal(lessons.data.lessons.length, 3);\n\n  for (const lesson of lessons.data.lessons) {\n    await request('POST', '/lessons/' + lesson.id + '/complete', {}, token);\n  }\n  const progress = await request('GET', '/progress', undefined, token);\n  assert.equal(progress.status, 200);\n  assert.ok(progress.data.points >= 125);\n  assert.equal(progress.data.achievements.find((item) => item.id === 'learner').earned, true);\n\n  const schemes = await request('GET', '/content/schemes', undefined, token);\n  assert.equal(schemes.data.schemes.length, 5);\n  assert.ok(schemes.data.schemes.every((item) => typeof item.eligible === 'boolean'));\n});\n\ntest('phone verification awards points once', async () => {\n  const signup = await request('POST', '/auth/signup', {\n    name: 'Test Worker', email: 'phone.test@example.com', password: 'Test@123'\n  });\n  await request('POST', '/auth/verify', { key: signup.data.key, purpose: 'signup', code: signup.data.devCode });\n  const login = await request('POST', '/auth/login', { email: 'phone.test@example.com', password: 'Test@123' });\n  const token = login.data.token;\n\n  const send = await request('POST', '/user/phone/send', { phone: '9999988888' }, token);\n  assert.match(send.data.devCode, /^\\d{4}$/);\n  const verified = await request('POST', '/user/phone/verify', { phone: '9999988888', code: send.data.devCode }, token);\n  assert.equal(verified.data.user.phoneVerified, true);\n\n  const sendAgain = await request('POST', '/user/phone/send', { phone: '9999988888' }, token);\n  const verifyAgain = await request('POST', '/user/phone/verify', { phone: '9999988888', code: sendAgain.data.devCode }, token);\n  const points = await request('GET', '/progress', undefined, token);\n  assert.equal(points.data.history.filter((item) => item.reason === 'Mobile number verified').length, 1);\n  assert.equal(verifyAgain.status, 200);\n});\n\ntest('admin overview and incident status updates', async () => {\n  const admin = await request('POST', '/auth/login', { email: 'admin@surakshasetu.in', password: 'Admin@123' });\n  const token = admin.data.token;\n\n  const overview = await request('GET', '/admin/overview', undefined, token);\n  assert.equal(overview.status, 200);\n  assert.equal(overview.data.zoneRisk.length, 6);\n  assert.ok(overview.data.directory.length >= 3);\n\n  const incident = overview.data.recentIncidents[0];\n  const updated = await request('PATCH', '/admin/incidents/' + incident.id + '/status', { status: 'resolved' }, token);\n  assert.equal(updated.status, 200);\n  assert.equal(updated.data.incident.status, 'resolved');\n\n  const worker = await request('POST', '/auth/login', { email: 'worker@demo.in', password: 'Demo@123' });\n  const denied = await request('GET', '/admin/overview', undefined, worker.data.token);\n  assert.equal(denied.status, 403);\n});\n\ntest('password reset works with an emailed demo code', async () => {\n  const email = 'reset.test@example.com';\n  await request('POST', '/auth/signup', { name: 'Reset User', email, password: 'OldPass123' });\n  const forgot = await request('POST', '/auth/forgot', { email });\n  assert.match(forgot.data.devCode, /^\\d{6}$/);\n  const reset = await request('POST', '/auth/reset-password', {\n    key: email, code: forgot.data.devCode, newPassword: 'NewPass123'\n  });\n  assert.equal(reset.status, 200);\n  const login = await request('POST', '/auth/login', { email, password: 'NewPass123' });\n  assert.equal(login.status, 200);\n});\n\ntest('static assets are served and unknown API routes return JSON 404', async () => {\n  const home = await fetch(base() + '/');\n  assert.equal(home.status, 200);\n  assert.match(await home.text(), /SurakshaSetu/);\n\n  const css = await fetch(base() + '/styles.css');\n  assert.equal(css.status, 200);\n\n  const missing = await request('GET', '/does-not-exist');\n  assert.equal(missing.status, 404);\n  assert.equal(missing.data.ok, false);\n});\n"
