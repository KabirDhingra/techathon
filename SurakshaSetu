on || '') + '</textarea></div>' +\n              '<div class=\"field\"><label>Photo (optional)</label><input type=\"file\" class=\"input\" id=\"incidentPhoto\" accept=\"image/*\" capture=\"environment\"></div>' +\n              '<div class=\"field\"><label>Location</label><div class=\"row\"><button type=\"button\" class=\"btn sm\" id=\"getLocation\">' + SS.icon('pin') + ' Use my current location</button>' +\n                '<span class=\"hint\" id=\"locationHint\">Not added</span></div></div>' +\n              '<button class=\"btn primary block\" type=\"submit\">' + SS.icon('alert') + ' Submit report · +15 points</button>' +\n            '</form>' +\n          '</div></div>' +\n          '<div class=\"card\"><div class=\"card-head\"><h3 class=\"card-title\">Your reports</h3></div><div class=\"card-body tight\">' +\n            ((data.incidents || []).length\n              ? data.incidents.filter((item) => item.source !== 'sos').slice(0, 10).map((item) =>\n                  '<div style=\"padding:9px 0;border-bottom:1px dashed var(--line)\">' +\n                    '<div class=\"row between\"><b style=\"font-size:12.5px\">' + esc(item.type) + '</b>' + SS.badge(item.severity) + '</div>' +\n                    '<p class=\"hint mb-1\" style=\"margin:4px 0\">' + esc(item.description) + '</p>' +\n                    '<div class=\"row between\"><span class=\"tiny muted\">' + SS.timeAgo(item.at) + '</span><span class=\"badge blue\">' + esc(item.status) + '</span></div>' +\n                  '</div>'\n                ).join('')\n              : SS.empty('No reports yet.', 'alert')) +\n          '</div></div>' +\n        '</div>';\n    },\n    async mount(root) {\n      let gps = null;\n      let photo = '';\n      SS.bindOnce(root, '#getLocation', 'click', async (event) => {\n        event.currentTarget.disabled = true;\n        root.querySelector('#locationHint').textContent = 'Locating…';\n        gps = await SS.geo();\n        root.querySelector('#locationHint').textConte